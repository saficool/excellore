{
  "realm": "excellore",
  "enabled": true,
  "displayName": "Excellore",
  "loginTheme": "excellore",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5) and passwordBlacklist(excellore-common.txt)",
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false
    }
  ],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "eventsEnabled": true,
  "eventsListeners": [],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "browserFlow": "excellore-browser",
  "authenticatorConfig": [
    {
      "alias": "excellore-loa-1",
      "config": { "loa-condition-level": "1", "loa-max-age": "36000" }
    },
    {
      "alias": "excellore-loa-2",
      "config": { "loa-condition-level": "2", "loa-max-age": "0" }
    }
  ],
  "authenticationFlows": [
    {
      "id": "0d11e28a-5d25-4ab4-9107-af5fb4bc5040",
      "alias": "excellore-browser",
      "description": "Excellore password and fresh OTP authentication levels",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "priority": 10,
          "requirement": "ALTERNATIVE",
          "authenticator": "auth-cookie"
        },
        {
          "priority": 20,
          "requirement": "ALTERNATIVE",
          "authenticatorFlow": true,
          "flowAlias": "excellore-levels"
        }
      ]
    },
    {
      "id": "6af957ce-6d30-44f4-b3cb-428a202442a3",
      "alias": "excellore-levels",
      "description": "Excellore password and fresh OTP authentication levels",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "priority": 10,
          "requirement": "CONDITIONAL",
          "authenticatorFlow": true,
          "flowAlias": "excellore-level-1"
        },
        {
          "priority": 20,
          "requirement": "CONDITIONAL",
          "authenticatorFlow": true,
          "flowAlias": "excellore-level-2"
        }
      ]
    },
    {
      "id": "7b5c2d4e-c0d6-4121-879e-197f4530a6ac",
      "alias": "excellore-level-1",
      "description": "Excellore password and fresh OTP authentication levels",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "priority": 10,
          "requirement": "REQUIRED",
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "excellore-loa-1"
        },
        {
          "priority": 20,
          "requirement": "REQUIRED",
          "authenticator": "auth-username-password-form"
