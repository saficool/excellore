{
  "title": "Excellore identity",
  "uid": "excellore-identity",
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "title": "Logins and failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(keycloak_user_events_total{event=~\"LOGIN|LOGIN_ERROR\"}[5m])) by (event)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Token endpoint p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(keycloak_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 3,
      "title": "BFF refresh failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(excellore_bff_refresh_failures_total[5m])) by (service_name)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Keycloak nodes",
      "type": "stat",
      "targets": [{ "expr": "sum(up{job=\"keycloak\"})" }]
    }
  ]
}
