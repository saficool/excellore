# dev-up.sh replaces every __GENERATE__ value with a random local credential.
# Copy the host, database, admin username, and admin password from each ignored
# Neon development project into .env. Host fields contain hostnames only.
# Never copy this file to a shared or production environment.
KEYCLOAK_NEON_DIRECT_HOST=
KEYCLOAK_NEON_DATABASE=neondb
KEYCLOAK_NEON_ADMIN_USERNAME=
KEYCLOAK_NEON_ADMIN_PASSWORD=
ACCESS_NEON_DIRECT_HOST=
ACCESS_NEON_POOLED_HOST=
ACCESS_NEON_DATABASE=neondb
ACCESS_NEON_ADMIN_USERNAME=
ACCESS_NEON_ADMIN_PASSWORD=
PROFILE_NEON_DIRECT_HOST=
PROFILE_NEON_POOLED_HOST=
PROFILE_NEON_DATABASE=neondb
PROFILE_NEON_ADMIN_USERNAME=
PROFILE_NEON_ADMIN_PASSWORD=
NOTIFICATIONS_NEON_DIRECT_HOST=
NOTIFICATIONS_NEON_POOLED_HOST=
NOTIFICATIONS_NEON_DATABASE=neondb
NOTIFICATIONS_NEON_ADMIN_USERNAME=
NOTIFICATIONS_NEON_ADMIN_PASSWORD=

KEYCLOAK_DB_PASSWORD=__GENERATE__
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
ACCESS_DB_PASSWORD=__GENERATE__
ACCESS_MIGRATOR_PASSWORD=__GENERATE__
ACCESS_APP_PASSWORD=__GENERATE__
ACCESS_PUBLISHER_PASSWORD=__GENERATE__
ACCESS_WORKER_PASSWORD=__GENERATE__
PROFILE_DB_PASSWORD=__GENERATE__
PROFILE_MIGRATOR_PASSWORD=__GENERATE__
PROFILE_APP_PASSWORD=__GENERATE__
PROFILE_PUBLISHER_PASSWORD=__GENERATE__
PROFILE_WORKER_PASSWORD=__GENERATE__
NOTIFICATIONS_DB_PASSWORD=__GENERATE__
NOTIFICATIONS_MIGRATOR_PASSWORD=__GENERATE__
NOTIFICATIONS_APP_PASSWORD=__GENERATE__
NOTIFICATIONS_PUBLISHER_PASSWORD=__GENERATE__
NOTIFICATIONS_WORKER_PASSWORD=__GENERATE__
RABBITMQ_USER=excellore
RABBITMQ_PASSWORD=__GENERATE__
OBJECTSTORE_ACCESS_KEY=__GENERATE__
OBJECTSTORE_SECRET_KEY=__GENERATE__
KEYCLOAK_ORIGIN=https://auth.excellore.localhost
KEYCLOAK_ADMIN_ORIGIN=http://auth.excellore.localhost:8080
SHELL_ORIGIN=https://excellore.localhost
PROFILE_ORIGIN=https://profile.excellore.localhost
ACCESS_ORIGIN=https://access.excellore.localhost
PLATFORM_ORIGIN=https://platform.excellore.localhost
SHELL_BFF_SECRET=__GENERATE__
PROFILE_BFF_SECRET=__GENERATE__
ACCESS_BFF_SECRET=__GENERATE__
PLATFORM_BFF_SECRET=__GENERATE__
WORKER_PROFILE_SECRET=__GENERATE__
WORKER_ACCESS_SECRET=__GENERATE__
ACCESS_WORKER_ACTOR_ID=__GENERATE__
PROFILE_WORKER_ACTOR_ID=__GENERATE__
SVC_SHELL_AUTHZ_SECRET=__GENERATE__
SVC_PROFILE_AUTHZ_SECRET=__GENERATE__
SVC_ACCESS_AUTHZ_SECRET=__GENERATE__
SVC_CATALOG_SYNC_SECRET=__GENERATE__
SVC_ACCESS_ADMIN_SECRET=__GENERATE__
SVC_PROFILE_IDENTITY_SECRET=__GENERATE__
SVC_NOTIFICATIONS_AUTHZ_SECRET=__GENERATE__
DEV_USER_PASSWORD=__GENERATE__
DEV_OTP_SECRET=__GENERATE__

# Local identity and application email default independently to Mailpit. To use an
# authenticated SMTP relay, set either transport to smtp and keep credentials in ignored .env.
KEYCLOAK_EMAIL_TRANSPORT=mailpit
APPLICATION_EMAIL_TRANSPORT=mailpit
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
KEYCLOAK_EMAIL_FROM_ADDRESS=
APPLICATION_EMAIL_FROM_ADDRESS=
KEYCLOAK_EMAIL_SMTP_USERNAME=
KEYCLOAK_EMAIL_SMTP_PASSWORD=
