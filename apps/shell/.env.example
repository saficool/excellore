# Copy to .env.local for standalone development. Use scripts/dev-up.sh for local secrets.
OIDC_ISSUER=http://auth.excellore.localhost:8080/realms/excellore
OIDC_CLIENT_ID=excellore-shell
OIDC_CLIENT_SECRET=__FROM_LOCAL_ENV__
OIDC_SCOPES=openid profile email
APP_BASE_URL=http://excellore.localhost:3000
SESSION_COOKIE_NAME=excellore-dev-shell
SESSION_STORE_URL=redis://localhost:6379
SESSION_KEY_PREFIX=shell:sess:
SESSION_ENCRYPTION_KEY=__GENERATE_BASE64URL_32_BYTES__
EXCELLORE_INSECURE_LOCAL_DEV=true
ACCESS_INTERNAL_URL=http://localhost:5002
AUTHZ_CLIENT_ID=svc-shell-authz
AUTHZ_CLIENT_SECRET=__FROM_LOCAL_ENV__
SHELL_ORIGIN=http://excellore.localhost:3000
PROFILE_ORIGIN=http://profile.excellore.localhost:3001
ACCESS_ORIGIN=http://access.excellore.localhost:3002
