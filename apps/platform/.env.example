# Copy to .env.local for standalone development. Use scripts/dev-up.sh for local secrets.
OIDC_ISSUER=https://auth.excellore.localhost/realms/excellore
OIDC_CLIENT_ID=excellore-platform
OIDC_CLIENT_SECRET=__FROM_LOCAL_ENV__
OIDC_SCOPES=openid profile email api-access
APP_BASE_URL=https://platform.excellore.localhost
SESSION_COOKIE_NAME=__Host-excellore-platform
SESSION_STORE_URL=redis://localhost:6379
SESSION_KEY_PREFIX=platform:sess:
SESSION_ENCRYPTION_KEY=__GENERATE_BASE64URL_32_BYTES__
EXCELLORE_INSECURE_LOCAL_DEV=true
API_BASE_URL=http://localhost:5002
SHELL_ORIGIN=https://excellore.localhost
PROFILE_ORIGIN=https://profile.excellore.localhost
ACCESS_ORIGIN=https://access.excellore.localhost
PLATFORM_ORIGIN=https://platform.excellore.localhost
