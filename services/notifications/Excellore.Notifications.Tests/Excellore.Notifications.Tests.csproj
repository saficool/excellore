    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Excellore.Notifications.Application/Excellore.Notifications.Application.csproj" />
    <ProjectReference Include="../Excellore.Notifications.Infrastructure/Excellore.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="../../../shared/dotnet/Excellore.Contracts/Excellore.Contracts.csproj" />
