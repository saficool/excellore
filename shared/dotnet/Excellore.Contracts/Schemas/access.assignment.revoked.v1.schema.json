{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:excellore:event:access.assignment.revoked.v1",
  "title": "access.assignment.revoked.v1",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "time",
    "tenantid",
    "correlationid",
    "actor",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "access.assignment.revoked.v1"
    },
    "source": {
      "const": "excellore/access"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "tenantid": {
      "type": "string",
      "format": "uuid"
    },
    "subject": {
      "type": "string"
    },
    "correlationid": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "required": ["sub", "type"],
      "properties": {
        "sub": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["human", "machine"]
        }
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "required": ["tenantId", "userId", "roleId"],
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "roleId": {
          "type": "string",
          "format": "uuid"
        },
        "name": false,
        "description": false,
        "permissions": false,
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "roleName": false,
        "email": false,
        "reason": false
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
