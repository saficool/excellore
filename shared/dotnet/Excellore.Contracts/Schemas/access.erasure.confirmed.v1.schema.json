{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:excellore:event:access.erasure.confirmed.v1",
  "title": "access.erasure.confirmed.v1",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "time",
    "correlationid",
    "actor",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "access.erasure.confirmed.v1"
    },
    "source": {
      "const": "excellore/access"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "tenantid": {
      "type": "string",
      "format": "uuid"
    },
    "subject": {
      "type": "string"
    },
    "correlationid": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "required": ["sub", "type"],
      "properties": {
        "sub": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["human", "machine"]
        }
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "required": ["scope", "service"],
      "properties": {
        "scope": {
          "enum": ["tenant", "user"]
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "service": {
          "const": "access"
        },
        "name": false,
        "email": false,
        "reason": false,
        "objectKey": false,
        "downloadUrl": false,
        "token": false,
        "details": false
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "scope": {
                "const": "tenant"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "tenantid": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "type": "object",
            "properties": {
              "userId": false,
              "tenantId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": ["tenantId"]
          }
        },
        "required": ["tenantid"]
      },
      "else": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "tenantId": false,
              "userId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": ["userId"]
          },
          "tenantid": {
            "type": "null"
          }
        }
      }
    }
  ]
}
